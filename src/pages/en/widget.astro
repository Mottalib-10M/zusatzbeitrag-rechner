---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/beitragsrechner/?lang=en" title="German health insurance contributions for every fund" width="100%" height="1250" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the German Health Fund Calculator: Free Code" description="Embed the calculator for German health insurance contributions and every fund's additional rate free of charge: copy the iframe, no account, no cookies, rates updated daily." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Widget', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Widget' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed the contribution calculator</h1>
    <p class="mt-3 text-lg text-navy-700">For HR teams, relocation services, international offices, unions and newsrooms: copy it once and the fund rates update themselves every day.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <h2>Code to copy</h2>
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
    <p>Conditions: the source link under the calculator stays visible, the calculator is not altered, and it is provided without warranty. Remove <code>?lang=en</code> for the German version.</p>
    <p>What your readers type stays on their device; the frame stores and measures nothing. Questions via the <a href={route('contact', lang)}>contact page</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src="/embed/beitragsrechner/?lang=en" title="German health insurance contributions for every fund" width="100%" height="1250" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
